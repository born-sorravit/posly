# Backend API root, including the version segment.
# Production: https://<render-service>.onrender.com/api/v1
# Inlined at build time — on Vercel, changing it needs a redeploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Canonical site URL, used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Identity Services client id (the same one the API checks `aud` against).
# Leave empty: the Google button stays disabled until sign-in is wired.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
