# Backend API root, including the version segment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Same OAuth client as apps/web. Add this app's origin (http://localhost:3003 and the
# production admin URL) to "Authorized JavaScript origins" in Google Cloud, or leave empty
# to sign in with email and password only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
