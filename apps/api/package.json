{
	"name": "@posly/api",
	"version": "0.0.1",
	"description": "Posly — multi-tenant POS SaaS API for small shops",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "biome format --write",
		"start:local": "NODE_ENV=local nest start --watch",
		"start:dev": "NODE_ENV=development nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/main",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
		"test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
		"migration:run": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/shared/database/typeorm.config.js",
		"migration:generate": "pnpm run build && node ./node_modules/typeorm/cli.js migration:generate ./src/shared/database/migrations/${name:?usage: name=AddProducts pnpm migration:generate} -d ./dist/shared/database/typeorm.config.js",
		"migration:create": "node ./node_modules/typeorm/cli.js migration:create ./src/shared/database/migrations/${name:?usage: name=AddProducts pnpm migration:create}",
		"migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/shared/database/typeorm.config.js",
		"seed:demo": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register ./src/shared/database/seeds/demo.seed.ts",
		"migration:run:src": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/shared/database/typeorm.config.ts",
		"subscription:set": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register -r tsconfig-paths/register ./src/scripts/set-plan.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1141.0",
		"@aws-sdk/s3-request-presigner": "^3.1141.0",
		"@nestjs/bullmq": "^11.0.5",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/throttler": "^6.7.0",
		"@nestjs/typeorm": "^11.0.3",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.3.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.1",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"stripe": "^22.6.2",
		"typeorm": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.0.0",
		"jest": "^30.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		}
	}
}
