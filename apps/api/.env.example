# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=local
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Default timezone for a new business; each business stores its own afterwards
APP_TIMEZONE=Asia/Bangkok
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — Railway PostgreSQL
# ---------------------------------------------------------------------------
# Local: the docker-compose container.
# Railway service: ${{Postgres.DATABASE_URL}} (private network, no TLS).
# From your machine against Railway: the Postgres service's DATABASE_PUBLIC_URL, with DB_SSL=true.
DATABASE_URL=postgres://posly:posly@localhost:5434/posly
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis — Railway Redis, for the cache and BullMQ
# ---------------------------------------------------------------------------
# Local: redis://localhost:6380 (docker-compose). Railway service: ${{Redis.REDIS_URL}}.
# Empty keeps the cache in-process; no BullMQ queue is registered yet.
REDIS_URL=
QUEUE_PREFIX=posly
CACHE_PREFIX=posly
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
# A just-rotated refresh token stays usable this long, so a browser firing several
# requests at once does not sign itself out. 0 makes rotation strictly single-use.
REFRESH_ROTATION_GRACE_MS=15000
BCRYPT_ROUNDS=10
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# OAuth client id from Google Cloud Console. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Storage — Railway Storage Bucket, S3-compatible (product images, store logos)
# ---------------------------------------------------------------------------
# From the bucket's Credentials tab, or on Railway ${{<Bucket>.ENDPOINT}}, ${{<Bucket>.BUCKET}},
# ${{<Bucket>.REGION}}, ${{<Bucket>.ACCESS_KEY_ID}} and ${{<Bucket>.SECRET_ACCESS_KEY}}.
# Leave empty to disable uploads.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Older Railway buckets need path-style URLs
S3_FORCE_PATH_STYLE=false
STORAGE_MAX_UPLOAD_BYTES=5242880
# Public origin of this API, no trailing slash. Image URLs are <PUBLIC_API_URL>/api/v1/media/…,
# which redirect to a short-lived presigned URL on the private bucket.
PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Mail — Resend (optional; without a key, mail is written to the log)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Posly <onboarding@resend.dev>

# Stripe, for paid plans (optional). Test keys start with sk_test_. Without a key the plans
# page asks shops to contact the team instead of paying online.
# Webhook: point https://<api>/api/v1/billing/webhook at customer.subscription.* and
# checkout.session.completed; locally `stripe listen --forward-to localhost:3001/api/v1/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
