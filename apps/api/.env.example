# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=local
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Default timezone for a new business; each business stores its own afterwards
APP_TIMEZONE=Asia/Bangkok
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Local: the docker-compose container.
# Supabase: copy the *Session pooler* URI from Connect in the dashboard. Three traps:
#   1. The direct host (db.<ref>.supabase.co) is IPv6-only, so Node returns ENOTFOUND on
#      an IPv4-only host. The pooler (aws-0-<region>.pooler.supabase.com) resolves to IPv4.
#   2. The database is always named `postgres`, never your project name.
#   3. Use the **session** pooler (port 5432), not the transaction pooler (6543):
#      transaction pooling drops LISTEN/NOTIFY (BullMQ) and prepared statements.
# e.g. postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://posly:posly@localhost:5434/posly
# Supabase requires TLS; set false only for the plain local container
DB_SSL=false
DB_LOGGING=false
# Supabase's session pooler allows 15 clients in total, shared with every BullMQ queue and
# worker. Keep the API's own pool small.
DB_POOL_MAX=3

# ---------------------------------------------------------------------------
# Queue (BullMQ on the PostgreSQL backend — same database, no Redis)
# ---------------------------------------------------------------------------
QUEUE_SCHEMA=bullmq
QUEUE_PREFIX=posly

# ---------------------------------------------------------------------------
# Cache (Upstash Redis, REST API) — optional; in-process Map unless BOTH are set
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=posly
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
# A just-rotated refresh token stays usable this long, so a browser firing several
# requests at once does not sign itself out. 0 makes rotation strictly single-use.
REFRESH_ROTATION_GRACE_MS=15000
BCRYPT_ROUNDS=10
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# OAuth client id from Google Cloud Console. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Storage — Supabase Storage (product images, store logos)
# ---------------------------------------------------------------------------
# Project URL and the service-role key from Project Settings > API. The key bypasses RLS:
# it lives only here, never in the frontend. Leave empty to disable uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket as **public** in the Supabase dashboard (Storage > New bucket).
SUPABASE_STORAGE_BUCKET=posly
STORAGE_MAX_UPLOAD_BYTES=5242880

# Stripe, for paid plans (optional). Test keys start with sk_test_. Without a key the plans
# page asks shops to contact the team instead of paying online.
# Webhook: point https://<api>/api/v1/billing/webhook at customer.subscription.* and
# checkout.session.completed; locally `stripe listen --forward-to localhost:3001/api/v1/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
